{
  "name": "damon-chat-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Damon core의 첫 서피스 — 프로바이더 라우팅이 눈에 보이는 채팅 데스크",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
