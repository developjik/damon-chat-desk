{
  "name": "damon-chat-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Damon core의 첫 서피스 — 프로바이더 라우팅이 눈에 보이는 채팅 데스크",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bombadil": "bombadil browser test --headless --no-sandbox --exit-on-violation --time-limit ${BOMBADIL_TIME_LIMIT:-3m} ${BOMBADIL_ORIGIN:-https://developjik.github.io/damon-chat-desk/} bombadil/desk.spec.ts",
    "typecheck:bombadil": "tsc -p bombadil --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.8.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "5.1.1"
  }
}
